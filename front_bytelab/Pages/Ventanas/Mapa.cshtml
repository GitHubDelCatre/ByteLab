@page
@model MapaModel
@{
    ViewData["Title"] = "Mapa de sucursales";
}
@section Estilos {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}
<h1 class="text-center">Mapa de sucursales</h1>
@await Html.PartialAsync("/Pages/Emergentes/Mensajes.cshtml")
<div class="row mt-3">
    <div class="col-md-8">
        <div id="mapa" class="mapa"></div>
    </div>
    <div class="col-md-4">
        <ul class="list-group">
            @foreach (var sucursal in Model.Sucursales)
            {
                <li class="list-group-item">
                    <b>@sucursal.NombreSucursal</b><br />
                    @sucursal.Direccion, @sucursal.Ciudad<br />
                    <small class="text-muted">@sucursal.HorarioAtencion - @sucursal.TelefonoContacto</small>
                </li>
            }
        </ul>
    </div>
</div>
@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script>
        const puntos = @Html.Raw(Model.PuntosJson);

        const mapa = L.map('mapa').setView([6.2442, -75.5812], 12);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(mapa);

        puntos.forEach(p => {
            L.marker([p.lat, p.lng]).addTo(mapa).bindPopup('<b>' + p.nombre + '</b><br>' + p.direccion);
        });
    </script>
}
